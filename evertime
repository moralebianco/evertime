#!/bin/sh

sem=0
tmp='/tmp/evertime'
dbp=$HOME'/.evertime'

start() {
	shift 1
	[ -f $tmp ] && exit 1
	[ -z "$1" ] && usage
	( evertime '__sh' "$@" & )
}

_stat() {
	acc=0
	basename "$1"

	while read -r time min note
	do
		acc=$((acc + min))
		min=$(date -d @$((min * 60)) -u '+  %H:%M ')
		printf '%s%+15s %s\n' "$min" "$time" "$note"
	done < "$1"
	printf '%d' $((acc / 1440))
	date -d @$((acc * 60)) -u '+:%H:%M'
}

stats() {
	[ $# -ge 1 ] && shift 1
	[ $# -ge 1 ] && v=$* || v=$(ls "$dbp")

	for f in $v
	do
		([ -f "$dbp/$f" ] || exit 2) && _stat "$dbp/$f"
	done
}

_stop() {
	[ -f $tmp ] || exit 1
	kill "$(cat $tmp)" && rm $tmp || exit 3
}

usage() {
	echo 'Usage: evertime [start <task> [note] | stats [task ...] | stop]' 1>&2
	exit 1
}

proc() {
	fn=$dbp/$2

	[ -f "$dbp/.tf" ] && sed -i -E "s/^>(.+)/\1/g" "$(cat "$dbp/.tf")"

	echo $$ > $tmp && echo "$fn" > "$dbp/.tf"
	echo ">$(date -u '+%D-%R') 0 $3" >> "$fn"
	min=0

	while [ $sem -eq 0 ]
	do
		min=$((min + 1))
		sleep 60
		sed -i -E "s/^>([^ ]+) ([0-9]+) (.*)$/>\1 $min \3/g" "$fn"
	done
	sed -i -E "s/^>(.+)/\1/g" "$fn"
}

main() {
	mkdir -p "$dbp"
	case $1 in
		start)  start "$@";;
		stats|'')
			stats "$@";;
		stop)   _stop;;
		*)      usage;;
	esac
}

if [ '__sh' = "$1" ]
then
	trap 'sem=1' TERM
	proc "$@"
else
	main "$@"
fi
